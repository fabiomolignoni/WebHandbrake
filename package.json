{
  "name": "webhandbrake",
  "version": "1.0.0",
  "private": true,
  "description": "A handbrake for the web: local-first, privacy-respecting browser extension to regulate your browsing with graduated friction.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:chrome": "node scripts/build.mjs --target=chrome",
    "build:firefox": "node scripts/build.mjs --target=firefox",
    "watch": "node scripts/build.mjs --watch",
    "package": "node scripts/build.mjs && node scripts/package.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/e2e/tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/build.mjs --target=chrome && playwright test",
    "lint:firefox": "node scripts/build.mjs --target=firefox && web-ext lint --source-dir dist/firefox",
    "check": "npm run typecheck && npm run lint && npm run i18n && npm run test",
    "i18n": "node scripts/check-i18n.mjs",
    "test:firefox": "node scripts/build.mjs --target=firefox && node tests/firefox/smoke.mjs",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "preact": "^11.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.12.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "web-ext": "^10.7.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fabiomolignoni/WebHandbrake.git"
  }
}
